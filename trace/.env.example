# TRACE 运行所需的环境变量（复制成 .env 或直接 export；不要把真实值提交到仓库）
#
# 用法：
#   export $(grep -v '^#' .env | xargs)     # 或手动 export 下面两个
# 两个 key 都必须在跑任何 CLI 子命令之前就设好——CLI 只从环境变量读，
# 缺失会 fail-fast 报 "API_KEY_MISSING / DEEPSEEK_API_KEY 未设置"，不会中途索要。

# AgentBay 沙箱：建会话 / provision / run / 销毁都要用
AGENTBAY_API_KEY=akm-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 被测的 deepseek-harness 在沙箱里调 DeepSeek 模型时要用（run 阶段）
# 注意：该 key 会被送进 AgentBay 沙箱环境（agent 需要它调模型）
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
